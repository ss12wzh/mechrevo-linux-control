    def _hist(self, key):
        """取/建一条曲线缓冲 (追加 O(1), 绘制时按时间窗裁剪)"""
        return self.hist.setdefault(key, deque(maxlen=HISTORY_MAXLEN))

    def _sync_core_cells(self, n):
        """按核数补齐每核迷你曲线格 (4 列)"""
        while len(self.core_cells) < n:
            i = len(self.core_cells)
            cell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            head = Gtk.Box(spacing=6)
            head.pack_start(label(f"CPU{i}", "metric-label"), True, True, 0)
            val = label("—", "metric-value", xalign=1.0)
            head.pack_end(val, False, False, 0)
            cell.pack_start(head, False, False, 0)
            chart = SparkChart("percent", height=34, compact=True)
            chart.set_series([("", "#73bdf5", self._hist(f"core{i}"))])
            cell.pack_start(chart, False, False, 0)
            self.core_grid.attach(cell, i % 4, i // 4, 1, 1)
            self.core_cells.append((chart, val))
            cell.show_all()

    def _fill_rows(self, box, rows):
        """资源明细行: [(名称, [(值文本, 颜色|None), ...])]; 行数不变时原位更新。
        行控件缓存挂在 box._row_kids 上 (不能从 get_children 反推, 那是行容器本身)"""
        kids = getattr(box, "_row_kids", [])
        if len(kids) != len(rows):
            for k in box.get_children():
                box.remove(k)
            kids = []
            for _r in rows:
                row = Gtk.Box(spacing=8)
                name = label("", "metric-sub")
                row.pack_start(name, True, True, 0)
                vals = []
                for _c in reversed(_r[1]):         # pack_end 逆序, 保证左->右与数据一致
                    w = label("", "metric-sub", xalign=1.0)
                    row.pack_end(w, False, False, 0)
                    vals.append(w)
                vals.reverse()
                box.pack_start(row, False, False, 0)
                kids.append((name, vals))
                row.show_all()
            box._row_kids = kids
        for (name, vals), (text, cells) in zip(kids, rows):
            name.set_text(text)
            for w, (v, color) in zip(vals, cells):
                if color:
                    w.set_markup(f'<span foreground="{color}">{v}</span>')
                else:
                    w.set_text(v)

    @staticmethod
    def _sum_key(rows, key):
        """多设备行的某个速率字段求和; 全为 None 返回 None (曲线断线)"""
        vals = [r[key] for r in rows if r.get(key) is not None]
        return sum(vals) if vals else None

    def _apply_monitor(self, st, paint=True):
        """paint=False: 页面不可见时只累积曲线数据, 不碰控件 (避免无谓重排)"""
        t = time.time()
        tel = st.get("telemetry") or {}
        c = st.get("cpu") or {}
        g = st.get("gpu") or {}
        tc = tel.get("cpu") or {}
        tm = tel.get("mem")

        def push(key, v):
            self._hist(key).append((t, v))

        # 功耗
        push("cpu_w", c.get("power_w"))
        push("gpu_w", None if g.get("suspended") else g.get("draw_w"))
        push("bat_w", tel.get("battery_w"))

        # 资源占用
        push("cpu_u", tc.get("total_pct"))
        push("mem_u", round(tm["used_mb"] / tm["total_mb"] * 100, 1)
             if tm and tm.get("total_mb") else None)
        push("gpu_u", None if g.get("suspended") else g.get("util_pct"))

        # 磁盘 / 网络 (多设备求和为合计曲线)
        disks = tel.get("disk") or []
        nets = tel.get("net") or []
        push("disk_r", self._sum_key(disks, "read_bps"))
        push("disk_w", self._sum_key(disks, "write_bps"))
        push("net_rx", self._sum_key(nets, "rx_bps"))
        push("net_tx", self._sum_key(nets, "tx_bps"))

        # 温度与风扇
        push("cpu_t", st.get("cpu_temp"))
        push("gpu_t", st.get("gpu_temp"))
        push("fan1", st.get("fan1_rpm"))
        push("fan2", st.get("fan2_rpm"))

        # 每核占用: 数据始终入缓冲, 控件只在可见时更新
        cores = tc.get("core_pct") or []
        for i, v in enumerate(cores):
            push(f"core{i}", v)
        if not paint:
            return
        self._sync_core_cells(len(cores))
        for i, v in enumerate(cores):
            self.core_cells[i][1].set_text(f"{v:.0f}%" if v is not None else "—")

        # 分区说明与明细行
        cpu_pct = tc.get("total_pct")
        self.mon_res_meta.set_text(" · ".join(x for x in (
            f"内存 {tm['used_mb'] / 1024:.1f}/{tm['total_mb'] / 1024:.0f} GB" if tm else "",
            f"负载 {cpu_pct:.0f}%" if cpu_pct is not None else "",
            f"{len(cores)} 核" if cores else "",
        ) if x))
        self._fill_rows(self.disk_rows, [
            (d["name"], [(f"{d['util_pct']:.0f}%" if d.get("util_pct") is not None else "—", None),
                         ("R " + fmt_rate(d.get("read_bps")), "#73bdf5"),
                         ("W " + fmt_rate(d.get("write_bps")), "#f4a073")])
            for d in disks])
        self._fill_rows(self.net_rows, [
            (n["name"], [("↓ " + fmt_rate(n.get("rx_bps")), "#4ec9b0"),
                         ("↑ " + fmt_rate(n.get("tx_bps")), "#f1d973")])
            for n in nets])

        for chart in (self.chart_power, self.chart_res, self.chart_disk, self.chart_net,
                      self.chart_temp, self.chart_fan, *(c_ for c_, _v in self.core_cells)):
            chart.queue_draw()

