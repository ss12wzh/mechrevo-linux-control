    # ---------------------------------------------------- 窗口行为
    def _drag_window(self, w, e):
        if e.button == 1:
            self.win.begin_move_drag(e.button, int(e.x_root), int(e.y_root), e.time)
        return False

    def set_view(self, name):
        self.stack.set_visible_child_name(name)
        for key, text, _icon in VIEWS:
            if key == name:
                self.view_lbl.set_text(text)
                self.view_icon.set_from_icon_name(view_icon_name(key), Gtk.IconSize.MENU)
                break
        self.cfg["view"] = name
        save_config(self.cfg)
        self._repaint_cached()

    def _cycle_view(self):
        """左下角视图按钮: 概览 -> 控制 -> 监控 -> 概览"""
        keys = [k for k, _n, _i in VIEWS]
        cur = self.stack.get_visible_child_name()
        self.set_view(keys[(keys.index(cur) + 1) % len(keys)] if cur in keys else keys[0])

    def _repaint_cached(self):
        """切页后用缓存状态即时补绘, 不等下一次轮询 (纯 UI, 不发请求)"""
        st = self.st
        if not st or "profile" not in st:
            return
        view = self.stack.get_visible_child_name()
        self._suppress = True
        try:
            if view == "overview":
                self._apply_overview(st)
            elif view == "controls":
                self._apply_controls(st)
            elif view == "monitor":
                self._apply_monitor(st, paint=True)
        except Exception:
            dbg("repaint: 异常\n" + traceback.format_exc())
        finally:
            self._suppress = False

    def set_keep_above(self, on):
        self.cfg["keep_above"] = on
        self.win.set_keep_above(on)
        save_config(self.cfg)

    def set_bubble(self, on):
        if on:
            if "bubble_pos" in self.cfg:
                self.bubble.move(*self.cfg["bubble_pos"])
            self.bubble.show_all()
            if self.st:
                self.bubble.update(self.st)
            self.refresh()              # 悬浮窗恢复 2s 节拍
        else:
            if self.bubble.get_visible():
                self.cfg["bubble_pos"] = list(self.bubble.get_position())
            self.bubble.hide()
        ctx = self.bubble_btn.get_style_context()
        (ctx.add_class if on else ctx.remove_class)("active")
        self.cfg["bubble"] = on
        save_config(self.cfg)

    def show_main(self):
        if "pos" in self.cfg and len(self.cfg["pos"]) == 2:
            w, h = self.win.get_size()
            self.win.move(*self._clamp_pos(self.cfg["pos"][0], self.cfg["pos"][1], w, h))
        self.win.show_all()
        self.win.present()
        self.refresh()                  # 从托盘恢复时立即拉一次, 不等 8s 慢轮询

    def toggle_main(self):
        if self.win.get_visible():
            self.on_delete(None, None)
        else:
            self.show_main()

    def on_delete(self, w, e):
        self._save_geometry()
        save_config(self.cfg)
        if not self.tray:
            self.on_quit()
            return True
        self.win.hide()
        return True

    def on_quit(self, *a):
        if self.win.get_visible():
            self._save_geometry()
        if self.bubble.get_visible():
            self.cfg["bubble_pos"] = list(self.bubble.get_position())
        save_config(self.cfg)
        if self.tray:
            self.tray.set_status(AyatanaAppIndicator3.IndicatorStatus.PASSIVE)
        Gtk.main_quit()

    # ---------------------------------------------------- 数据刷新
    def _ui_active(self):
        """窗口可见 (非最小化) 或悬浮窗可见 -> 保持 2s 轮询, 否则降到 8s"""
        try:
            if self.win.get_visible():
                gdkwin = self.win.get_window()
                if gdkwin is None or not (gdkwin.get_state() & Gdk.WindowState.ICONIFIED):
                    return True
        except Exception:
            pass
        return bool(self.bubble.get_visible())

    def _schedule_refresh(self):
        GLib.timeout_add(2000 if self._ui_active() else 8000, self._refresh_tick)

    def _refresh_tick(self):
        self.refresh()
        self._schedule_refresh()
        return False

    def refresh(self):
        # 标志超过 15 秒未复位 (工作线程意外退出) 就强制重来, 保证 GUI 永远能恢复刷新
        if self._refreshing and time.monotonic() - self._refresh_t < 15:
            dbg("refresh: 上一次仍在进行, 跳过")
            return True
        dbg("refresh: 调度")
        self._refreshing = True
        self._refresh_t = time.monotonic()
        threading.Thread(target=self._refresh_worker, daemon=True).start()
        return True

    def _refresh_worker(self):
        try:
            st = call({"op": "status"})
        except BaseException as e:
            st = {"ok": False, "error": repr(e)}
        dbg(f"worker: 请求完成 ({'ok' if 'profile' in st else st.get('error')})")
        GLib.idle_add(self._apply, st)

    def _query_mux(self):
        r = call({"op": "mux", "value": "query"})
        GLib.idle_add(self._apply_mux, r)

    def _apply_mux(self, r):
        if not r.get("ok"):
            self.sec_mux.meta.set_text(r.get("error") or "查询失败")
            return False
        mode = r.get("mux_mode")
        name = dict(MUX_MODES).get(mode) or r.get("state") or "未知"
        power = r.get("dgpu_power")
        meta = f"当前: {name}"
        if power:
            meta += f" · {power}"
        if r.get("battery_igpu_active") or (self.st or {}).get("battery_igpu_active"):
            meta += " · 离电独显待机"
        rt = (self.st or {}).get("gpu_runtime")
        if rt == "suspended":
            meta += " · 独显 D3hot"
        if r.get("warning"):
            meta += " · EFI 读失败已用缓存"
        self.sec_mux.meta.set_text(meta)
        if mode in self.mux_tabs.buttons:
            self.mux_tabs.select(mode)
        return False

    def _apply(self, st):
        self._refreshing = False
        ctx = self.live_dot.get_style_context()
        if not st or "profile" not in st:
            ctx.remove_class("live")
            self.status_lbl.set_text(f"守护进程离线: {st.get('error', '')}"[:60])
            self.status_lbl.show()
            return False
        self.status_lbl.hide()
        ctx.add_class("live")
        ctx.add_class("pulse")
        GLib.timeout_add(420, lambda: (ctx.remove_class("pulse"), False)[1])

        self.st = st
        self.feats = st.get("features") or self.feats
        self._suppress = True
        try:
            view = self.stack.get_visible_child_name()
            self._apply_title(st)
            # 只更新当前可见页; 隐藏页在切换时用缓存状态即时重绘
            if view == "overview":
                self._apply_overview(st)
            elif view == "controls":
                self._apply_controls(st)
            self._apply_monitor(st, paint=(view == "monitor"))
            dbg("apply: 完成")
        except Exception:
            dbg("apply: 异常\n" + traceback.format_exc())
        finally:
            self._suppress = False
        if self.bubble.get_visible():
            self.bubble.update(st)
        return False

    def _apply_title(self, st):
        prof = st.get("profile")
        caps = self.feats.get("cpu_ppt_table") or {}
        src = PPT_SOURCE.get(self.feats.get("cpu_ppt_source"), "")
        for key, b in self.profile_tabs.buttons.items():
            b.set_tooltip_text(f"CPU 功耗墙约 {caps[key]} W ({src})" if key in caps else None)
        if prof in PROFILE_NAMES:
            self.profile_tabs.select(prof)
        else:
            self.profile_tabs.select(None)

    def _apply_overview(self, st):
        f = self.feats
        g = st.get("gpu", {})
        prof = PROFILE_NAMES.get(st.get("profile"), st.get("profile") or "")

        drv = f.get("gpu_driver")
        draw = g.get("draw_w")
        self.total_tween.set(draw if draw is not None else (0.0 if g.get("suspended") else None))
        if g.get("suspended"):
            self.cost.set_text(f"独显休眠中 · {prof}档")
        elif draw is not None:
            cur_l, max_l = g.get("current_limit_w"), g.get("max_limit_w")
            self.cost.set_text(f"上限 {cur_l or 0:.0f} W · 最大 {max_l or 0:.0f} W · {prof}档")
        elif drv is False:
            self.cost.set_text("NVIDIA 驱动未加载 · 请安装匹配当前内核的模块")
        else:
            self.cost.set_text(g.get("error") or "nvidia-smi 不可用")

        # CPU
        c = st.get("cpu", {})
        ct = st.get("cpu_temp")
        cal = st.get("calibration") or {}
        self.sec_cpu.plan.set_text(f"校准中 {cal.get('step', '')}" if cal.get("running") else f.get("cpu_model", ""))
        avg, peak, pw = c.get("freq_avg_mhz"), c.get("freq_max_mhz"), c.get("power_w")
        max_mhz = f.get("cpu_max_mhz") or 5500
        plat = st.get("platform") or {}
        cap = plat.get("cpu_ppt_w")
        boost = st.get("cpu_boost")
        gov, epp = st.get("cpu_governor"), st.get("cpu_epp")
        power_hint = ""
        if gov == "performance":
            power_hint = "调度 performance（空载高功耗）"
        elif epp == "performance":
            power_hint = "EPP performance（高功耗）"
        self.sec_cpu.meta.set_text(" · ".join(x for x in (
            f"{ct:.0f}°C" if ct is not None else "",
            f"功耗墙 ≈{cap} W" if cap else "",
            "睿频已关" if boost is False else f"最高 {max_mhz} MHz",
            power_hint) if x))
        self.m_cpu["temp"].update(f"{ct:.0f}°C" if ct is not None else "—", (ct or 0) / 100, self._temp_level(ct))
        self.m_cpu["power"].update(f"{pw:.1f} W" if pw is not None else "—", (pw or 0) / (cap or 120),
                                   "warn" if cap and pw and pw >= cap * 0.95 else None,
                                   f"{prof}档功耗墙 ≈{cap} W ({PPT_SOURCE.get(plat.get('cpu_ppt_source'), '')})"
                                   if cap else None)
        self.m_cpu["freq"].update(f"{avg} MHz" if avg else "—", (avg or 0) / max_mhz)
        self.m_cpu["peak"].update(f"{peak} MHz" if peak else "—", (peak or 0) / max_mhz)

        # GPU
        gt = st.get("gpu_temp")
        self.sec_gpu.plan.set_text("驱动未加载" if drv is False else f.get("gpu_name", ""))
        if g.get("suspended"):
            self.sec_gpu.meta.set_text("独显已休眠 (RTD3), 不读取以免唤醒")
            self.gpu_grid.hide()
        elif drv is False:
            self.sec_gpu.meta.set_text("NVIDIA 驱动未加载 · 独显无法管理")
            self.gpu_grid.hide()
        else:
            self.gpu_grid.show()
            clock, util = g.get("clock_mhz"), g.get("util_pct")
            used, total = g.get("mem_used_mb"), g.get("mem_total_mb")
            self.sec_gpu.meta.set_text(" · ".join(x for x in (
                f"{gt:.0f}°C" if gt is not None else "",
                f"{draw:.1f} W" if draw is not None else "",
                f"动态加速 {plat['db_w']} W" if plat.get("db_w") is not None else "") if x))
            self.m_gpu["temp"].update(f"{gt:.0f}°C" if gt is not None else "—", (gt or 0) / 100, self._temp_level(gt))
            self.m_gpu["util"].update(f"{util:.0f}%" if util is not None else "—", (util or 0) / 100)
            if used is not None and total:
                used_txt = f"{used:.0f} MB" if used < 1024 else f"{used / 1024:.1f} GB"
                self.m_gpu["mem"].update(f"{used_txt} / {total / 1024:.0f} GB", used / total)
            else:
                self.m_gpu["mem"].update("—", 0)
            self.m_gpu["clock"].update(f"{clock:.0f} MHz" if clock is not None else "—", (clock or 0) / 3000)

        # 风扇
        mode = st.get("fan_mode")
        g = st.get("fan_guard") or {}
        self.sec_fan.plan.set_text(FAN_MODE_NAMES.get(mode, mode or ""))
        if mode == "auto-boost":
            self.sec_fan.meta.set_text(f"温度超过 {g.get('on')}°C, 已自动全速")
        elif mode == "boost":
            self.sec_fan.meta.set_text("手动强冷, 全速运转")
        else:
            self.sec_fan.meta.set_text(f"高温自动强冷 ≥{g.get('on')}°C" if g.get("enabled") else "转速由 EC 固件曲线决定")
        for key in ("fan1", "fan2"):
            rpm = st.get(f"{key}_rpm")
            if rpm:
                self._fan_peak = max(self._fan_peak, rpm)
            self.m_fan[key].update(f"{rpm} RPM" if rpm is not None else "—", (rpm or 0) / self._fan_peak)

        # 电池
        b = st.get("battery", {})
        cap, cyc, limit = b.get("capacity_pct"), b.get("cycles"), st.get("charge_limit_pct")
        self.sec_bat.plan.set_text(f"循环 {cyc} 次" if cyc is not None else "")
        state = {"Charging": "充电中", "Discharging": "使用电池", "Full": "已充满",
                 "Not charging": "已接电源 · 未充电"}.get(b.get("status"), b.get("status") or "")
        self.sec_bat.meta.set_text(state)
        self.m_bat["cap"].update(f"{cap}%" if cap is not None else "—", (cap or 0) / 100,
                                 "crit" if cap is not None and cap < 20 else "accent")
        self.m_bat["limit"].update(f"{limit}%" if limit is not None else "读取失败", (limit or 0) / 100, "accent")

    def _apply_controls(self, st):
        f = self.feats
        mode = st.get("fan_mode")
        g = st.get("fan_guard") or {}
        self.fan_tabs.select("boost" if mode == "boost" else "auto")
        self.sec_fan_ctl.plan.set_text(FAN_MODE_NAMES.get(mode, ""))
        self.sec_fan_ctl.meta.set_text("本机 EC 仅支持全速模式, 不支持自定义曲线")
        self.guard_sw.set_active(bool(g.get("enabled")))
        self.guard_desc.set_text(f"≥{g.get('on')}°C 全速, 回落到 {g.get('off')}°C 交还 EC")
        for b in self.fan_tabs.buttons.values():
            b.set_sensitive(bool(f.get("fan_boost")))
        if not f.get("mux"):
            for b in self.mux_tabs.buttons.values():
                b.set_sensitive(False)
        limit = st.get("charge_limit_pct")
        if limit is not None and self.charge_scale not in self._dragging:
            self.charge_scale.set_value(limit)
        self.charge_val.set_text(f"{int(self.charge_scale.get_value())}%")

        rainbow = st.get("kbd_rainbow")
        br = st.get("kbd_brightness")
        br = int(br) if br and str(br).isdigit() else 0
        self.kbd_tabs.select("rainbow" if rainbow else ("off" if br == 0 else "solid"))
        if self.kbd_scale not in self._dragging:
            self.kbd_scale.set_value(br)
        rgb = tuple(int(x) for x in (st.get("kbd_rgb") or "").split()[:3]) if st.get("kbd_rgb") else None
        for c, b in self.swatches:
            ctx = b.get_style_context()
            (ctx.add_class if rgb == c else ctx.remove_class)("selected")
        self.sec_kbd.plan.set_text("彩虹动画" if rainbow else (f"RGB {' '.join(map(str, rgb))}" if rgb else ""))
        self.sec_kbd.meta.set_text(f"亮度 {br} / 200")

        toggles = st.get("toggles", {})
        for key, sw in self.switches.items():
            if key == "ac_led_off":
                sw.set_active(bool(st.get("ac_led_off")))
            elif key == "hybrid_battery_igpu":
                sw.set_sensitive(True)
                sw.set_active(bool(st.get("hybrid_battery_igpu")))
            else:
                sw.set_sensitive(key in toggles)
                sw.set_active(toggles.get(key, False))

    @staticmethod
    def _temp_level(t):
        if t is None:
            return None
        return "crit" if t >= 88 else ("warn" if t >= 75 else "accent")

    # ---------------------------------------------------- 操作
    def _send(self, cmd, then_refresh=True):
        def run():
            r = call(cmd)
            if not r.get("ok"):
                GLib.idle_add(self._flash_error, r.get("error") or r.get("raw") or "操作失败")
            if then_refresh:
                # refresh() 返回 True (给旧定时器用); 作为 idle 回调会永久重复 -> 点一次按钮就 100% CPU
                GLib.idle_add(lambda: (self.refresh(), False)[1])
        threading.Thread(target=run, daemon=True).start()

    def _flash_error(self, msg):
        self.status_lbl.set_text(str(msg)[:60])
        self.status_lbl.show()
        GLib.timeout_add(4000, lambda: (self.status_lbl.hide(), False)[1])
        return False

    # ---------------------------------------------------- 自动更新
    def _startup_update_check(self):
        if mrvupdate:
            self._start_update_check(manual=False)
        return False

    def _manual_check_update(self):
        if self._upd_checking:
            return
        self._upd_checking = True
        self._flash_message("正在检查更新…")
        self._start_update_check(manual=True)

    def _start_update_check(self, manual=False):
        def run():
            try:
                if mrvupdate is None:
                    raise RuntimeError("更新模块不可用")
                info = mrvupdate.check(VERSION, force=manual)
                GLib.idle_add(self._update_checked, info, manual)
            except Exception as e:
                GLib.idle_add(self._update_check_failed, e, manual)
        threading.Thread(target=run, daemon=True).start()

    def _update_checked(self, info, manual):
        self._upd_checking = False
        self._upd = info
        avail = bool(info.get("available"))
        if avail:
            self.update_dot.show()
            self.update_dot.set_tooltip_text(f"发现新版本 v{info.get('version')}，点击查看")
        else:
            self.update_dot.hide()
        if manual:
            self._show_update_dialog(info)
        return False

    def _update_check_failed(self, exc, manual):
        self._upd_checking = False
        kind = getattr(exc, "kind", "")
        msg = getattr(exc, "message", str(exc))
        pretty = {
            "network": "网络不可用，请检查网络后重试",
            "rate_limit": "GitHub API 访问受限，请稍后再试",
            "no_release": "仓库尚未发布 Release，稍后再试",
        }.get(kind, msg)
        if manual:
            self._info_dialog("检查更新", pretty)
        else:
            dbg(f"update: {kind} {msg}")
        return False

    def _flash_message(self, msg, ms=3000):
        self.status_lbl.set_text(msg)
        ctx = self.status_lbl.get_style_context()
        ctx.remove_class("status-error")
        self.status_lbl.show()

        def done():
            self.status_lbl.hide()
            ctx.add_class("status-error")
            return False
        GLib.timeout_add(ms, done)

