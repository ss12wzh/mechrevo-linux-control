            btn = add_class(Gtk.Button(label="下载并安装"), "pill-btn")
            btn.connect("clicked", lambda *_: self._download_update(info, progress, status, btn))
            row.pack_end(btn, False, False, 0)
        else:
            box.pack_start(label("该版本未提供 .deb 资产，请到发布页手动下载。", "metric-sub"),
                           False, False, 0)
        box.pack_start(row, False, False, 0)
        dlg.show_all()
        dlg.run()
        dlg.destroy()

    def _download_update(self, info, progress, status, btn):
        asset = info.get("asset") or {}
        dest = os.path.join(GLib.get_user_cache_dir(), "mrv-ctl",
                            asset.get("name") or "mrv-ctl_update.deb")
        btn.set_sensitive(False)
        progress.show()
        status.show()
        status.set_text("准备下载…")

        def prog(done, total):
            GLib.idle_add(self._update_progress, progress, status, done, total)

        def run():
            try:
                mrvupdate.download(asset["url"], dest, prog)
                GLib.idle_add(self._update_downloaded, dest, status, progress)
            except Exception as e:
                GLib.idle_add(self._update_failed, e, status)
        threading.Thread(target=run, daemon=True).start()

    def _update_progress(self, progress, status, done, total):
        if total:
            progress.set_fraction(min(1.0, done / total))
            status.set_text(f"下载中 {done / 1048576:.1f} / {total / 1048576:.1f} MB")
        else:
            progress.pulse()
            status.set_text(f"下载中 {done / 1048576:.1f} MB")
        return False

    def _update_downloaded(self, path, status, progress):
        progress.set_fraction(1.0)
        status.set_text("下载完成，等待授权安装…")

        def run():
            try:
                mrvupdate.install_deb(path)
                GLib.idle_add(self._update_installed, status)
            except Exception as e:
                GLib.idle_add(self._update_failed, e, status)
        threading.Thread(target=run, daemon=True).start()
        return False

    def _update_installed(self, status):
        status.set_text("安装完成，请重启 mrv-ctl 生效")
        self.update_dot.hide()
        return False

    def _update_failed(self, exc, status):
        msg = getattr(exc, "message", str(exc))
        status.show()
        status.set_text(f"失败：{msg}")
        status.get_style_context().add_class("status-error")
        return False

    def on_profile(self, key):
        if self._suppress:
            return True
        self.profile_tabs.select(key)
        self._send({"op": "profile", "value": key})
        return True

    def on_fan(self, key):
        if self._suppress:
            return True
        self._send({"op": "fan", "value": key})
        return True

    def on_guard(self, sw, pspec):
        if not self._suppress:
            self._send({"op": "fan_guard", "enabled": sw.get_active()})

    def on_mux(self, key):
        if self._suppress:
            return True
        self._pending_mux = key
        tip = {
            "igpu": "切到集显后独显将不可用, 务必重启",
            "standard": "混合输出, 集显驱动屏幕、独显可按需唤醒, 需重启",
            "dgpu": "独显直连, 全部显示由独显输出, 需重启",
        }.get(key, "需重启")
        self.mux_confirm_lbl.set_text(f"切换为「{dict(MUX_MODES)[key]}」? {tip}")
        self.mux_confirm.set_reveal_child(True)
        return True

    def _mux_cancel(self):
        self._pending_mux = None
        self.mux_confirm.set_reveal_child(False)
        self.mux_tabs.select(None)

    def _mux_commit(self):
        key = self._pending_mux
        self.mux_confirm.set_reveal_child(False)
        if not key:
            return

        def run():
            r = call({"op": "mux", "value": key, "confirm": True})
            GLib.idle_add(self._mux_done, key, r)
        threading.Thread(target=run, daemon=True).start()

    def _mux_done(self, key, r):
        if r.get("ok"):
            self.sec_mux.meta.set_text(f"已设为{dict(MUX_MODES)[key]}, 重启后生效")
        else:
            self.mux_tabs.select(None)
            self._flash_error(r.get("error") or r.get("raw") or "切换失败")
        return False

    def on_charge(self, *a):
        if not self._suppress:
            self._send({"op": "charge", "value": int(self.charge_scale.get_value())})
        return False

    def on_effect(self, key):
        if self._suppress:
            return True
        cmd = {"op": "kbd", "effect": key}
        if key != "off" and int(self.kbd_scale.get_value()) == 0:
            cmd["brightness"] = 100
        self._send(cmd)
        return True

    def on_brightness(self, *a):
        if not self._suppress:
            self._send({"op": "kbd", "brightness": int(self.kbd_scale.get_value())})
        return False

    def set_color(self, rgb):
        cmd = {"op": "kbd", "effect": "solid", "rgb": list(rgb)}
        if int(self.kbd_scale.get_value()) == 0:
            cmd["brightness"] = 100
        self._send(cmd)

    def on_custom_color(self, btn):
        dlg = Gtk.ColorChooserDialog(title="键盘灯颜色", transient_for=self.win)
        if dlg.run() == Gtk.ResponseType.OK:
            c = dlg.get_rgba()
            self.set_color((int(c.red * 200), int(c.green * 200), int(c.blue * 200)))
        dlg.destroy()

    def on_switch(self, sw, pspec, key):
        if self._suppress:
            return
        if key == "ac_led_off":
            self._send({"op": "ac_led_off", "value": sw.get_active()})
        elif key == "hybrid_battery_igpu":
            self._send({"op": "hybrid_battery_igpu", "value": sw.get_active()})
        else:
            self._send({"op": "toggle", "name": key, "value": sw.get_active()})


# ============================================================ 单实例
SINGLE_SOCK = f"/run/user/{os.getuid()}/mrv-gui.sock"


def _wake_existing_instance():
    """已有实例在跑就唤醒它并退出本次启动 (避免重复托盘图标)"""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(1.0)
    try:
        s.connect(SINGLE_SOCK)
        s.sendall(b"show")
        return True
    except OSError:
        return False
    finally:
        s.close()


def _serve_single_instance(app):
    try:
        os.unlink(SINGLE_SOCK)
    except OSError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        srv.bind(SINGLE_SOCK)
        srv.listen(2)
    except OSError:
        return

    def loop():
        while True:
            try:
                conn, _ = srv.accept()
            except OSError:
                return
            try:
                conn.recv(16)
                GLib.idle_add(app.show_main)
            except OSError:
                pass
            finally:
                conn.close()

    threading.Thread(target=loop, daemon=True).start()


def main():
    if _wake_existing_instance():
        print("mrv-ctl 已在运行，已唤出窗口", file=sys.stderr)
        return
    app = MrvApp()
    _serve_single_instance(app)
    app.win.show_all()
    if app.cfg.get("bubble"):
        app.set_bubble(True)
    Gtk.main()


if __name__ == "__main__":
    main()
