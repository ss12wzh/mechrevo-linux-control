    # ---------------------------------------------------- 构建 / 尺寸
    @staticmethod
    def _workarea():
        """当前主显示器工作区 (逻辑像素, GTK 已处理缩放系数)"""
        disp = Gdk.Display.get_default()
        mon = disp.get_primary_monitor() if disp else None
        if mon is None:
            return Gdk.Rectangle(x=0, y=0, width=1920, height=1080)
        return mon.get_workarea()

    def _initial_size(self):
        """默认 420 宽; 高度按工作区自适应; 用户拉过则记住尺寸"""
        wa = self._workarea()
        size = self.cfg.get("size") or []
        if len(size) == 2:
            w, h = int(size[0]), int(size[1])
        else:
            w, h = 420, min(920, int(wa.height * 0.86))
        w = max(360, min(w, max(360, min(760, wa.width - 40))))
        h = max(420, min(h, max(420, wa.height - 40)))
        return w, h

    def _clamp_pos(self, x, y, w, h):
        """把窗口位置夹到可见工作区内 (换屏/改缩放后不会跑到屏幕外)"""
        wa = self._workarea()
        x = max(wa.x, min(int(x), wa.x + wa.width - min(int(w), wa.width)))
        y = max(wa.y, min(int(y), wa.y + wa.height - min(int(h), wa.height)))
        return x, y

    def _save_geometry(self):
        w, h = self.win.get_size()
        if w > 1 and h > 1:
            self.cfg["size"] = [w, h]
            self.cfg["pos"] = list(self._clamp_pos(*self.win.get_position(), w, h))

    def _scroll(self, child):
        # 固定窗口尺寸 + 页内滚动 (窗口可自由缩放, 内容不再撑大窗口)
        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sw.set_overlay_scrolling(True)
        # 悬浮滚动条会盖住右侧文字 (EC 自动/重启生效等), 给内容留出滚动条宽度
        child.set_margin_end(10)
        sw.add(child)
        sw.show_all()           # Gtk.Stack 只能切换到已显示的子页
        return sw

