def cr_text(cr, text, x, y, size=8.5, rgba=(0.64, 0.68, 0.73, 0.9),
            right=False, center=False):
    """cairo 上画等宽文本 (PangoCairo, 中文有字体回退); 返回 (宽, 高)"""
    lay = PangoCairo.create_layout(cr)
    lay.set_text(text, -1)
    lay.set_font_description(Pango.FontDescription(f"DejaVu Sans Mono {size}"))
    w, h = lay.get_pixel_size()
    if right:
        x -= w
    elif center:
        x -= w / 2
    cr.set_source_rgba(*rgba)
    cr.move_to(x, y)
    PangoCairo.show_layout(cr, lay)
    return w, h


def fmt_rate(bps, short=False):
    """字节速率 -> 紧凑文本; short 用于图表 (省去 /s)"""
    if bps is None:
        return "—"
    if bps >= 1024 ** 3:
        s = f"{bps / 1024 ** 3:.2f}G"
    elif bps >= 1024 ** 2:
        s = f"{bps / 1024 ** 2:.1f}M"
    elif bps >= 1024:
        s = f"{bps / 1024:.0f}K"
    else:
        return f"{bps:.0f}" if short else f"{bps:.0f} B/s"
    return s if short else s + "B/s"


def _hex_rgb(s):
    s = s.lstrip("#")
    return (int(s[0:2], 16) / 255.0, int(s[2:4], 16) / 255.0, int(s[4:6], 16) / 255.0)


class SparkChart(Gtk.DrawingArea):
    """多序列时间曲线: 深色圆角槽底 + 细网格 + 柔光细线; v=None 断线。
    mode: percent/temp (固定 0-100) | watt | rpm | bytes (自动 nice 上限)"""

    def __init__(self, mode="percent", height=88, compact=False, warn=None):
        super().__init__()
        self.mode = mode
        self.compact = compact
        self.warn = warn                # 警戒虚线值 (温度图 88)
        self.series = []                # [(label, "#rrggbb", deque[(t, v)])]
        self.span = HISTORY_SPAN_S
        self.set_size_request(-1, height)
        self.connect("draw", self._on_draw)

    def set_series(self, series):
        self.series = series

    # ---------- 纵轴 ----------
    def _ceiling(self, peak):
        if self.mode in ("percent", "temp"):
            return 100.0
        if self.mode == "watt":
            return next((s for s in (10, 25, 50, 75, 100, 150, 200, 300) if peak <= s), 300.0)
        if self.mode == "rpm":
            return next((s for s in (1000, 2000, 3000, 4000, 5000, 6000, 8000, 10000)
                         if peak <= s), 10000.0)
        # bytes: 1024 进制阶梯, 下限 512 避免空图纵轴塌缩
        v, scale = max(peak, 1.0), 1.0
        while v > 1024 and scale < 1024 ** 3:
            v /= 1024.0
            scale *= 1024.0
        return next((s * scale for s in (1, 2, 5, 10, 20, 50, 100, 200, 500, 1024)
                     if v <= s), scale * 1024)

    def _fmt_val(self, v):
        if v is None:
            return "—"
        if self.mode == "percent":
            return f"{v:.0f}%"
        if self.mode == "watt":
            return f"{v:.0f}W" if v >= 100 else f"{v:.1f}W"
        if self.mode == "rpm":
            return f"{v:.0f}"
        if self.mode == "temp":
            return f"{v:.0f}°"
        return fmt_rate(v, short=True)

    def _fmt_axis(self, v):
        if self.mode == "percent":
            return f"{v:g}%"
        if self.mode == "watt":
            return f"{v:g}W"
        if self.mode == "temp":
            return f"{v:g}°"
        if self.mode == "rpm":
            return f"{v:g}"
        return fmt_rate(v, short=True)

    @staticmethod
    def _round_rect(cr, x, y, w, h, r):
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -1.5708, 0)
        cr.arc(x + w - r, y + h - r, r, 0, 1.5708)
        cr.arc(x + r, y + h - r, r, 1.5708, 3.1416)
        cr.arc(x + r, y + r, r, 3.1416, 4.7124)
        cr.close_path()

    def _on_draw(self, w, cr):
        a = w.get_allocation()
        W, H = a.width, a.height
        if W < 30 or H < 18:
            return False
        cr.set_source_rgba(4 / 255, 8 / 255, 13 / 255, 0.46)
        self._round_rect(cr, 0.5, 0.5, W - 1, H - 1, 4)
        cr.fill()

        if self.compact:
            x0, y0, x1, y1 = 3.0, 3.0, W - 3.0, H - 3.0
        else:
            x0, y0, x1, y1 = 38.0, 15.0, W - 6.0, H - 11.0

        now = time.time()
        t_lo = now - self.span
        lines, peak, has_data = [], 0.0, False
        for _label, _color, buf in self.series:
            line = []
            for t, v in buf:
                if t < t_lo:
                    continue
                if v is None:
                    line.append(None)
                else:
                    peak = max(peak, v)
                    has_data = True
                    line.append((x0 + (t - t_lo) / self.span * (x1 - x0), v))
            lines.append(line)
        ymax = self._ceiling(peak)

        def ymap(v):
            return y1 - min(max(v, 0.0), ymax) / ymax * (y1 - y0)

        # 网格与纵轴刻度
        if not self.compact:
            for frac in (1.0, 0.5, 0.0):
                gy = y1 - frac * (y1 - y0)
                cr.set_source_rgba(1, 1, 1, 0.06)
                cr.set_line_width(1)
                cr.move_to(x0, gy + 0.5)
                cr.line_to(x1, gy + 0.5)
                cr.stroke()
                cr_text(cr, self._fmt_axis(ymax * frac), x0 - 5, gy - 6,
                        8.5, (0.64, 0.68, 0.73, 0.75), right=True)

        # 警戒线 (温度图)
        if self.warn is not None and not self.compact and self.warn <= ymax:
            cr.set_source_rgba(244 / 255, 119 / 255, 136 / 255, 0.5)
            cr.set_line_width(1)
            cr.set_dash([3, 3])
            cr.move_to(x0, ymap(self.warn))
            cr.line_to(x1, ymap(self.warn))
            cr.stroke()
            cr.set_dash([])

        if not has_data:
            cr_text(cr, "等待数据…" if not self.compact else "—", (x0 + x1) / 2,
                    (y0 + y1) / 2 - 6, 9, (0.64, 0.68, 0.73, 0.55), center=True)
            return False

        # 曲线: 先柔光后实线, 断点断开
        for (_label, color, _buf), line in zip(self.series, lines):
            rgb = _hex_rgb(color)
            for alpha, width in ((0.20, 2.8), (1.0, 1.3)):
                cr.set_source_rgba(*rgb, alpha)
                cr.set_line_width(width)
                cr.set_line_cap(1)
                started = False
                for pt in line:
                    if pt is None:
                        started = False
                        continue
                    px, v = pt
                    if started:
                        cr.line_to(px, ymap(v))
                    else:
                        cr.move_to(px, ymap(v))
                        started = True
                cr.stroke()

        # 图例: 色点 + 名称 + 最近值
        if not self.compact:
            cx = x0 + 1
            for label, color, buf in self.series:
                cur = next((v for _t, v in reversed(buf) if v is not None), None)
                rgb = _hex_rgb(color)
                cr.set_source_rgba(*rgb, 0.95)
                cr.arc(cx + 3.5, 8.5, 2.4, 0, 6.2832)
                cr.fill()
                tw, _ = cr_text(cr, label, cx + 9, 2.5, 8.5, (0.64, 0.68, 0.73, 0.9))
                vw, _ = cr_text(cr, self._fmt_val(cur), cx + 9 + tw + 4, 2.5, 8.5, (*rgb, 0.95))
                cx += 9 + tw + 4 + vw + 9
                if cx > W - 30:
                    break
        return False


