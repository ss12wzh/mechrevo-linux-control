    def _scroll(self, child):
        # 窗口高度跟随内容 (取两页中较高者), 超过上限才滚动, 滚动条隐藏
        sw = Gtk.ScrolledWindow(propagate_natural_height=True, max_content_height=760)
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.EXTERNAL)
        sw.add(child)
        sw.show_all()           # Gtk.Stack 只能切换到已显示的子页
        return sw

