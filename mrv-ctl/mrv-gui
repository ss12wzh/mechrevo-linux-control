        if visual:
            self.win.set_visual(visual)
        self.win.set_app_paintable(True)

    def _blur_bg(self):
        """抓取桌面 -> 高斯模糊 -> 作为窗口背景图 (真毛玻璃)"""
        try:
            root = Gdk.get_default_root_window()
            w, h = root.get_width(), root.get_height()
            pb = Gdk.pixbuf_get_from_window(root, 0, 0, w, h)
            if pb is None:
                return
            tmp = "/tmp/mrv-bg-raw.png"
            pb.savev(tmp, "png", [], [])
            im = Image.open(tmp).convert("RGB")
            if im.width > 1280:                       # 降采样加速模糊
                r = 1280 / im.width
                im = im.resize((1280, int(im.height * r)), Image.BILINEAR)
            im = im.filter(ImageFilter.GaussianBlur(26))
            im = Image.blend(im, Image.new("RGB", im.size, (26, 28, 36)), 0.26)
            im.save("/tmp/mrv-gui-bg.png")
        except Exception as e:
            log_gui(f"毛玻璃背景失败: {e}")

    def _pango(self, widget, size=None, weight=None, spacing=None):
        """GTK3 无 CSS letter-spacing, 用 Pango 属性设置字间距/字重"""
        attrs = Pango.AttrList()
        if size:
            attrs.insert(Pango.attr_size_new_absolute(int(size * Pango.SCALE)))
        if weight:
            attrs.insert(Pango.attr_weight_new(weight))
        if spacing:
            attrs.insert(Pango.attr_letter_spacing_new(int(spacing * Pango.SCALE)))
        widget.set_attributes(attrs)
        return widget

    def _card(self, icon, title, dim=False):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.get_style_context().add_class("card")
        head = Gtk.Box(spacing=8)
        ic = Gtk.Label(label=icon)
        ic.get_style_context().add_class("summary")
        head.pack_start(ic, False, False, 0)
        t = Gtk.Label(label=title, xalign=0)
        t.get_style_context().add_class("card-title-dim" if dim else "card-title")
        head.pack_start(t, False, False, 0)
        box.pack_start(head, False, False, 0)
        return box, head

    def _tool_btn(self, icon, text, cb):
        b = Gtk.Button()
        b.get_style_context().add_class("tool-btn")
        vb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        i = Gtk.Label(label=icon)
        i.get_style_context().add_class("tool-icon")
        t = Gtk.Label(label=text)
        t.get_style_context().add_class("tool-text")
        vb.pack_start(i, False, False, 0)
        vb.pack_start(t, False, False, 0)
        b.add(vb)
        b.connect("clicked", cb)
        return b

    def _toggle_more(self):
        self.more_rev.set_reveal_child(not self.more_rev.get_reveal_child())
        return False

    def on_more_btn(self, btn):
        self._toggle_more()

    # ---------------- 数据刷新
    def refresh(self):
        if not self.updating:
            self.updating = True
            threading.Thread(target=self._refresh_thread, daemon=True).start()
        return True

    def _refresh_thread(self):
        st = call({"op": "status"}, timeout=10)
        GLib.idle_add(self._apply_status, st)

    def _style_text(self):
        """用 Pango 设置字间距/字重 (GTK3 CSS 不支持 letter-spacing)"""
        self._pango(self.title_lbl, size=13, weight=Pango.Weight.SEMIBOLD, spacing=0.6)
        for w in self.profile_btns.values():
            self._pango(w.get_child(), size=11, weight=Pango.Weight.MEDIUM, spacing=0.4)
        for w in self.mux_btns.values():
            self._pango(w.get_child(), size=11, weight=Pango.Weight.MEDIUM, spacing=0.4)

    def _apply_status(self, st):
        self.updating = False
        if not st or "profile" not in st:
            return False
        self.st = st
        f = st.get("features", {})
        if f:
            self.feats = f
            self.title_lbl.set_text(f"mrv-ctl  ·  {f.get('product', '')}")
            if not f.get("mux"):
                for b in self.mux_btns.values():
                    b.set_sensitive(False)
            if not f.get("rgb"):
                self.kbd_sw.set_sensitive(False)
        self._suppress = True
        prof = st.get("profile")
        for key, btn in self.profile_btns.items():
            btn.set_active(key == prof)
        cpu, gpu = st.get("cpu_temp"), st.get("gpu_temp")
        self.temp_lbl.set_text({
            "office": "省电策略", "balanced": "均衡策略", "boost": "性能策略",
        }.get(st.get("profile"), ""))
        # 实时监控
        c = st.get("cpu", {})
        self.tm_labels["cpu_freq"].set_text(
            f"{c.get('freq_avg_mhz') or '--'} MHz" + (f" (峰值 {c['freq_max_mhz']})" if c.get("freq_max_mhz") else ""))
        self.tm_labels["cpu_power"].set_text(
            f"{c['power_w']} W" if c.get("power_w") is not None else "不可用")
        g2 = st.get("gpu", {})
        self.tm_labels["gpu_freq"].set_text(
            f"{g2['clock_mhz']:.0f} MHz" if g2.get("clock_mhz") is not None else "--")
        if g2.get("mem_used_mb") is not None:
            self.tm_labels["gpu_mem"].set_text(
                f"{g2['mem_used_mb']:.0f} / {g2['mem_total_mb']:.0f} MB")
        else:
            self.tm_labels["gpu_mem"].set_text("--")
        self.tm_labels["gpu_util"].set_text(
            f"{g2['util_pct']:.0f}%" if g2.get("util_pct") is not None else "--")
        self.tm_sub.set_text(f"{st.get('fan1_rpm') or 0} RPM" if st.get("fan1_rpm") else "")

        # 仪表盘: 大号 GPU 功耗 + 副信息
        g = st.get("gpu", {})
        draw = g.get("draw_w")
        if draw is not None:
            self.big_val.set_text(f"{draw:.1f}")
            self.limit_lbl.set_text(f"上限 {g.get('current_limit_w', 0):.0f} / 最大 {g.get('max_limit_w', 0):.0f} W")
        else:
            self.big_val.set_text("--")
            self.limit_lbl.set_text("nvidia-smi 不可用")
        parts = []
        if cpu is not None:
            parts.append(f"CPU {cpu:.0f}°")
        if gpu is not None:
            parts.append(f"GPU {gpu:.0f}°")
        if st.get("fan1_rpm"):
            parts.append(f"风扇 {st['fan1_rpm']}")
        if st.get("profile"):
            parts.append({"office": "静音档", "balanced": "平衡档", "boost": "狂暴档"}.get(st["profile"], st["profile"]))
        self.dash_sub.set_text("   ·   ".join(parts))
        b = st.get("battery", {})
        cyc, cap = b.get("cycles"), b.get("capacity_pct")
        ac = "⚡" if b.get("ac_online") else ""
        self.batt_lbl.set_text(f"循环 {cyc} 次 · {cap}% {ac}" if cap is not None else "")
        self.charge_scale.set_value(st.get("charge_limit_pct") or 100)
        # 灯光摘要
        ch_on = 1 if st.get("kbd_rainbow") else (1 if (st.get("kbd_brightness") or "0") != "0" else 0)
        self.led_lbl.set_text(f"2 通道 · {ch_on} 开启")
        self.kbd_sw.set_active(bool(ch_on))
        self.effect_combo.set_active(1 if st.get("kbd_rainbow") else 0)
        self.ac_led_sw.set_active(st.get("ac_led_off", False))
        # 更多开关
        if f.get("fn_lock"):
            self._sync_switch("fn_lock")
        if f.get("super_key"):
            self._sync_switch("super_key_enable")
        if f.get("breathing"):
            self._sync_switch("breathing_in_suspend")
        on_cnt = sum(1 for s in self.switches.values() if s.get_active())
        self.more_lbl.set_text(f"{on_cnt}/{len(self.switches)} 开启")
        self._suppress = False
        if self.float_visible:
            self.floatwin.update(st)
        return False

    def _sync_switch(self, name):
        try:
            with open(f"/sys/devices/platform/INOU0000:00/{name}") as fp:
                val = fp.read().strip() == "1"
            self.switches.get(name).set_active(val)
        except OSError:
            pass

    def _async(self, cmd):
        threading.Thread(target=lambda: call(cmd), daemon=True).start()

    # ---------------- 回调
    def set_profile(self, key):
        self._async({"op": "profile", "value": key})

    def on_profile(self, btn, key):
        if self._suppress:
            return
        if btn.get_active():
            self.set_profile(key)

    def on_mux(self, btn, key):
        if self._suppress:
            return
        if not btn.get_active():
            return
        dlg = Gtk.MessageDialog(transient_for=self.win, modal=True,
                                message_type=Gtk.MessageType.WARNING,
                                buttons=Gtk.ButtonsType.OK_CANCEL,
                                text=f"切换显卡模式为「{btn.get_label()}」？")
        dlg.format_secondary_text("切换会下电/上电独显并需要重启系统生效，确定继续？")
        resp = dlg.run()
        dlg.destroy()
        if resp == Gtk.ResponseType.OK:
            self._async({"op": "mux", "value": key, "confirm": True})
        else:
            GLib.timeout_add(200, lambda: self._uncheck_mux(key))

    def _uncheck_mux(self, key):
        self._suppress = True
        self.mux_btns[key].set_active(False)
        self._suppress = False
        return False

    def on_charge(self, scale, event):
        if self._suppress:
            return
        self._async({"op": "charge", "value": int(scale.get_value())})
        return False

    def on_kbd_toggle(self, sw, pspec):
        if self._suppress:
            return
        self._async({"op": "kbd", "brightness": 150 if sw.get_active() else 0})

    def on_effect(self, combo):
        if self._suppress:
            return
        idx = combo.get_active()
        if idx == 1:
            self._async({"op": "kbd", "effect": "rainbow", "brightness": 150})
        elif idx == 2:
            self._async({"op": "kbd", "effect": "off"})
        else:
            self._async({"op": "kbd", "effect": "solid", "brightness": 150})

    def on_color(self, btn):
        dlg = Gtk.ColorChooserDialog(title="键盘灯颜色", transient_for=self.win)
        if dlg.run() == Gtk.ResponseType.OK:
            rgba = dlg.get_rgba()
            self._async({"op": "kbd", "effect": "solid",
                         "rgb": [int(rgba.red * 200), int(rgba.green * 200), int(rgba.blue * 200)]})
        dlg.destroy()

    def on_ac_led(self, sw, pspec):
        if self._suppress:
            return
        self._async({"op": "ac_led_off", "value": sw.get_active()})

    def on_more_switch(self, sw, pspec, name):
        if self._suppress:
            return
        self._async({"op": "toggle", "name": name, "value": sw.get_active()})

    def on_float(self, btn=None):
        self.float_visible = not self.float_visible
        if self.float_visible:
            self.floatwin.show_all()
            if self.st:
                self.floatwin.update(self.st)
        else:
            self.floatwin.hide()

    def on_toggle_win(self, item=None):
        if self.win.get_visible():
            self.win.hide()
        else:
            self.win.show_all()

    def on_delete(self, w, e):
        self.win.hide()
        return True

    def on_quit(self, *a):
        try:
            self.floatwin.close()
        except Exception:
            pass
        if self.tray:
            self.tray.set_status(AyatanaAppIndicator3.IndicatorStatus.PASSIVE)
        Gtk.main_quit()


def main():
    gui = MrvGUI()
    gui.win.show_all()
    gui.more_rev.set_reveal_child(False)
    Gtk.main()


if __name__ == "__main__":
    main()
