    def _menu(self, relative_to, items):
        pop = Gtk.Popover.new(relative_to)
        pop.set_position(Gtk.PositionType.TOP)
        add_class(pop, "mrv-menu")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        pop.items = {}
        for it in items:
            if it is None:
                box.pack_start(Gtk.Separator(), False, False, 0)
                continue
            key, text, cb = it
            b = Gtk.Button()
            b.add(label(text))
            b.set_size_request(118, -1)
            b.connect("clicked", lambda _b, f=cb, p=pop: (p.popdown(), f()))
            pop.items[key] = b
            box.pack_start(b, False, False, 0)
        box.show_all()
        pop.add(box)
        return pop

    def _popup(self, pop):
        marks = {"overview": self.stack.get_visible_child_name() == "overview",
                 "controls": self.stack.get_visible_child_name() == "controls",
                 "keep_above": self.cfg.get("keep_above", False),
                 "bubble": self.bubble.get_visible()}
        for key, b in pop.items.items():
            ctx = b.get_style_context()
            (ctx.add_class if marks.get(key) else ctx.remove_class)("current")
        pop.popup()

    def _build_tray(self):
        if not HAS_INDICATOR:
            return None
        tray = AyatanaAppIndicator3.Indicator.new(
            "mrv-ctl", "mrv-ctl", AyatanaAppIndicator3.IndicatorCategory.APPLICATION_STATUS)
        tray.set_status(AyatanaAppIndicator3.IndicatorStatus.ACTIVE)
        menu = Gtk.Menu()
        items = [("打开 mrv-ctl", lambda *_: self.show_main())]
        items += [(f"性能: {name}", lambda *_, k=key: self.on_profile(k)) for key, name in PROFILES]
        items += [("悬浮窗", lambda *_: self.set_bubble(not self.bubble.get_visible()))]
        for text, cb in items:
            item = Gtk.MenuItem(label=text)
            item.connect("activate", cb)
            menu.append(item)
        menu.append(Gtk.SeparatorMenuItem())
        q = Gtk.MenuItem(label="退出")
        q.connect("activate", self.on_quit)
        menu.append(q)
        menu.show_all()
        tray.set_menu(menu)
        return tray

    # ---------------------------------------------------- 窗口行为
    def _drag_window(self, w, e):
        if e.button == 1:
            self.win.begin_move_drag(e.button, int(e.x_root), int(e.y_root), e.time)
        return False

    def set_view(self, name):
        self.stack.set_visible_child_name(name)
        overview = name == "overview"
        self.view_lbl.set_text("概览" if overview else "控制")
        self.view_icon.set_from_icon_name("view-grid-symbolic" if overview else "preferences-system-symbolic",
                                          Gtk.IconSize.MENU)
        self.cfg["view"] = name
        save_config(self.cfg)

    def set_keep_above(self, on):
        self.cfg["keep_above"] = on
        self.win.set_keep_above(on)
        save_config(self.cfg)

    def set_bubble(self, on):
        if on:
            if "bubble_pos" in self.cfg:
                self.bubble.move(*self.cfg["bubble_pos"])
            self.bubble.show_all()
            if self.st:
                self.bubble.update(self.st)
        else:
            if self.bubble.get_visible():
                self.cfg["bubble_pos"] = list(self.bubble.get_position())
            self.bubble.hide()
        ctx = self.bubble_btn.get_style_context()
        (ctx.add_class if on else ctx.remove_class)("active")
        self.cfg["bubble"] = on
        save_config(self.cfg)

    def show_main(self):
        if "pos" in self.cfg:
            self.win.move(*self.cfg["pos"])
        self.win.show_all()
        self.win.present()

    def toggle_main(self):
        if self.win.get_visible():
            self.on_delete(None, None)
        else:
            self.show_main()

    def on_delete(self, w, e):
        self.cfg["pos"] = list(self.win.get_position())
        save_config(self.cfg)
        if not self.tray:
            self.on_quit()
            return True
        self.win.hide()
        return True

    def on_quit(self, *a):
        if self.win.get_visible():
            self.cfg["pos"] = list(self.win.get_position())
        if self.bubble.get_visible():
            self.cfg["bubble_pos"] = list(self.bubble.get_position())
        save_config(self.cfg)
        if self.tray:
            self.tray.set_status(AyatanaAppIndicator3.IndicatorStatus.PASSIVE)
        Gtk.main_quit()

    # ---------------------------------------------------- 数据刷新
    def refresh(self):
        if not self._refreshing:
            self._refreshing = True
            threading.Thread(target=lambda: GLib.idle_add(self._apply, call({"op": "status"})),
                             daemon=True).start()
        return True

    def _query_mux(self):
        r = call({"op": "mux", "value": "query"})
        GLib.idle_add(self._apply_mux, r)

    def _apply_mux(self, r):
        known = {"dGPU(独显直连)": "当前: 独显直连", "iGPU(混合输出)": "当前: 混合输出"}
        self.sec_mux.meta.set_text(known.get(r.get("state"), "当前状态未知") if r.get("ok") else "查询失败")
        return False

    def _apply(self, st):
        self._refreshing = False
        ctx = self.live_dot.get_style_context()
        if not st or "profile" not in st:
            ctx.remove_class("live")
            self.status_lbl.set_text(f"守护进程离线: {st.get('error', '')}"[:60])
            self.status_lbl.show()
            return False
        self.status_lbl.hide()
        ctx.add_class("live")
        ctx.add_class("pulse")
        GLib.timeout_add(420, lambda: (ctx.remove_class("pulse"), False)[1])

        self.st = st
        self.feats = st.get("features") or self.feats
        self._suppress = True
        try:
            self._apply_title(st)
            self._apply_overview(st)
            self._apply_controls(st)
        finally:
            self._suppress = False
        if self.bubble.get_visible():
            self.bubble.update(st)
        return False

    def _apply_title(self, st):
        prof = st.get("profile")
        caps = self.feats.get("cpu_ppt_table") or {}
        for key, b in self.profile_tabs.buttons.items():
            b.set_tooltip_text(f"CPU 功耗墙约 {caps[key]} W (本机实测)" if key in caps else None)
        if prof in PROFILE_NAMES:
            self.profile_tabs.select(prof)
        else:
            self.profile_tabs.select(None)

    def _apply_overview(self, st):
        f = self.feats
        g = st.get("gpu", {})
        prof = PROFILE_NAMES.get(st.get("profile"), st.get("profile") or "")

        draw = g.get("draw_w")
        self.total_tween.set(draw if draw is not None else (0.0 if g.get("suspended") else None))
        if g.get("suspended"):
            self.cost.set_text(f"独显休眠中 · {prof}档")
        elif draw is not None:
            cur_l, max_l = g.get("current_limit_w"), g.get("max_limit_w")
            self.cost.set_text(f"上限 {cur_l or 0:.0f} W · 最大 {max_l or 0:.0f} W · {prof}档")
        else:
            self.cost.set_text(g.get("error") or "nvidia-smi 不可用")

        # CPU
        c = st.get("cpu", {})
        ct = st.get("cpu_temp")
        self.sec_cpu.plan.set_text(f.get("cpu_model", ""))
        avg, peak, pw = c.get("freq_avg_mhz"), c.get("freq_max_mhz"), c.get("power_w")
        max_mhz = f.get("cpu_max_mhz") or 5500
        plat = st.get("platform") or {}
        cap = plat.get("cpu_ppt_w")
        self.sec_cpu.meta.set_text(" · ".join(x for x in (
            f"{ct:.0f}°C" if ct is not None else "",
            f"功耗墙 ≈{cap} W" if cap else "", f"最高 {max_mhz} MHz") if x))
        self.m_cpu["temp"].update(f"{ct:.0f}°C" if ct is not None else "—", (ct or 0) / 100, self._temp_level(ct))
        self.m_cpu["power"].update(f"{pw:.1f} W" if pw is not None else "—", (pw or 0) / (cap or 120),
                                   "warn" if cap and pw and pw >= cap * 0.95 else None,
                                   f"{prof}档功耗墙 ≈{cap} W (实测)" if cap else None)
        self.m_cpu["freq"].update(f"{avg} MHz" if avg else "—", (avg or 0) / max_mhz)
        self.m_cpu["peak"].update(f"{peak} MHz" if peak else "—", (peak or 0) / max_mhz)

        # GPU
        gt = st.get("gpu_temp")
        self.sec_gpu.plan.set_text(f.get("gpu_name", ""))
        if g.get("suspended"):
            self.sec_gpu.meta.set_text("独显休眠中, 不读取以免唤醒")
            self.gpu_grid.hide()
        else:
            self.gpu_grid.show()
            clock, util = g.get("clock_mhz"), g.get("util_pct")
            used, total = g.get("mem_used_mb"), g.get("mem_total_mb")
            self.sec_gpu.meta.set_text(" · ".join(x for x in (
                f"{gt:.0f}°C" if gt is not None else "",
                f"{draw:.1f} W" if draw is not None else "",
                f"动态加速 {plat['db_w']} W" if plat.get("db_w") is not None else "") if x))
            self.m_gpu["temp"].update(f"{gt:.0f}°C" if gt is not None else "—", (gt or 0) / 100, self._temp_level(gt))
            self.m_gpu["util"].update(f"{util:.0f}%" if util is not None else "—", (util or 0) / 100)
            if used is not None and total:
                used_txt = f"{used:.0f} MB" if used < 1024 else f"{used / 1024:.1f} GB"
                self.m_gpu["mem"].update(f"{used_txt} / {total / 1024:.0f} GB", used / total)
            else:
                self.m_gpu["mem"].update("—", 0)
            self.m_gpu["clock"].update(f"{clock:.0f} MHz" if clock is not None else "—", (clock or 0) / 3000)

        # 风扇
        mode = st.get("fan_mode")
        g = st.get("fan_guard") or {}
        self.sec_fan.plan.set_text(FAN_MODE_NAMES.get(mode, mode or ""))
        if mode == "auto-boost":
            self.sec_fan.meta.set_text(f"温度超过 {g.get('on')}°C, 已自动全速")
        elif mode == "boost":
            self.sec_fan.meta.set_text("手动强冷, 全速运转")
        else:
            self.sec_fan.meta.set_text(f"高温自动强冷 ≥{g.get('on')}°C" if g.get("enabled") else "转速由 EC 固件曲线决定")
        for key in ("fan1", "fan2"):
            rpm = st.get(f"{key}_rpm")
            if rpm:
                self._fan_peak = max(self._fan_peak, rpm)
            self.m_fan[key].update(f"{rpm} RPM" if rpm is not None else "—", (rpm or 0) / self._fan_peak)

        # 电池
        b = st.get("battery", {})
        cap, cyc, limit = b.get("capacity_pct"), b.get("cycles"), st.get("charge_limit_pct")
        self.sec_bat.plan.set_text(f"循环 {cyc} 次" if cyc is not None else "")
        state = {"Charging": "充电中", "Discharging": "使用电池", "Full": "已充满",
                 "Not charging": "已接电源 · 未充电"}.get(b.get("status"), b.get("status") or "")
        self.sec_bat.meta.set_text(state)
        self.m_bat["cap"].update(f"{cap}%" if cap is not None else "—", (cap or 0) / 100,
                                 "crit" if cap is not None and cap < 20 else "accent")
        self.m_bat["limit"].update(f"{limit}%" if limit is not None else "读取失败", (limit or 0) / 100, "accent")

    def _apply_controls(self, st):
        f = self.feats
        mode = st.get("fan_mode")
        g = st.get("fan_guard") or {}
        self.fan_tabs.select("boost" if mode == "boost" else "auto")
        self.sec_fan_ctl.plan.set_text(FAN_MODE_NAMES.get(mode, ""))
        self.sec_fan_ctl.meta.set_text("本机 EC 仅支持全速模式, 不支持自定义曲线")
        self.guard_sw.set_active(bool(g.get("enabled")))
        self.guard_desc.set_text(f"≥{g.get('on')}°C 全速, 回落到 {g.get('off')}°C 交还 EC")
        for b in self.fan_tabs.buttons.values():
            b.set_sensitive(bool(f.get("fan_boost")))
        if not f.get("mux"):
            for b in self.mux_tabs.buttons.values():
                b.set_sensitive(False)
        limit = st.get("charge_limit_pct")
        if limit is not None and self.charge_scale not in self._dragging:
            self.charge_scale.set_value(limit)
        self.charge_val.set_text(f"{int(self.charge_scale.get_value())}%")

        rainbow = st.get("kbd_rainbow")
        br = st.get("kbd_brightness")
        br = int(br) if br and str(br).isdigit() else 0
        self.kbd_tabs.select("rainbow" if rainbow else ("off" if br == 0 else "solid"))
        if self.kbd_scale not in self._dragging:
            self.kbd_scale.set_value(br)
        rgb = tuple(int(x) for x in (st.get("kbd_rgb") or "").split()[:3]) if st.get("kbd_rgb") else None
        for c, b in self.swatches:
            ctx = b.get_style_context()
            (ctx.add_class if rgb == c else ctx.remove_class)("selected")
        self.sec_kbd.plan.set_text("彩虹动画" if rainbow else (f"RGB {' '.join(map(str, rgb))}" if rgb else ""))
        self.sec_kbd.meta.set_text(f"亮度 {br} / 200")

        toggles = st.get("toggles", {})
        for key, sw in self.switches.items():
            if key == "ac_led_off":
                sw.set_active(bool(st.get("ac_led_off")))
            else:
                sw.set_sensitive(key in toggles)
                sw.set_active(toggles.get(key, False))

    @staticmethod
    def _temp_level(t):
        if t is None:
            return None
        return "crit" if t >= 88 else ("warn" if t >= 75 else "accent")

    # ---------------------------------------------------- 操作
    def _send(self, cmd, then_refresh=True):
        def run():
            r = call(cmd)
            if not r.get("ok"):
                GLib.idle_add(self._flash_error, r.get("error") or r.get("raw") or "操作失败")
            if then_refresh:
                GLib.idle_add(self.refresh)
        threading.Thread(target=run, daemon=True).start()

    def _flash_error(self, msg):
        self.status_lbl.set_text(str(msg)[:60])
        self.status_lbl.show()
        GLib.timeout_add(4000, lambda: (self.status_lbl.hide(), False)[1])
        return False

    def on_profile(self, key):
        if self._suppress:
            return True
        self.profile_tabs.select(key)
        self._send({"op": "profile", "value": key})
        return True

    def on_fan(self, key):
        if self._suppress:
            return True
        self._send({"op": "fan", "value": key})
        return True

    def on_guard(self, sw, pspec):
        if not self._suppress:
            self._send({"op": "fan_guard", "enabled": sw.get_active()})

    def on_mux(self, key):
        if self._suppress:
            return True
        self._pending_mux = key
        self.mux_confirm_lbl.set_text(f"切换为「{dict(MUX_MODES)[key]}」? 需重启")
        self.mux_confirm.set_reveal_child(True)
        return True

    def _mux_cancel(self):
        self._pending_mux = None
        self.mux_confirm.set_reveal_child(False)
        self.mux_tabs.select(None)

    def _mux_commit(self):
        key = self._pending_mux
        self.mux_confirm.set_reveal_child(False)
        if not key:
            return

        def run():
            r = call({"op": "mux", "value": key, "confirm": True})
            GLib.idle_add(self._mux_done, key, r)
        threading.Thread(target=run, daemon=True).start()

    def _mux_done(self, key, r):
        if r.get("ok"):
            self.sec_mux.meta.set_text(f"已设为{dict(MUX_MODES)[key]}, 重启后生效")
        else:
            self.mux_tabs.select(None)
            self._flash_error(r.get("error") or r.get("raw") or "切换失败")
        return False

    def on_charge(self, *a):
        if not self._suppress:
            self._send({"op": "charge", "value": int(self.charge_scale.get_value())})
        return False

    def on_effect(self, key):
        if self._suppress:
            return True
        cmd = {"op": "kbd", "effect": key}
        if key != "off" and int(self.kbd_scale.get_value()) == 0:
            cmd["brightness"] = 100
        self._send(cmd)
        return True

    def on_brightness(self, *a):
        if not self._suppress:
            self._send({"op": "kbd", "brightness": int(self.kbd_scale.get_value())})
        return False

    def set_color(self, rgb):
        cmd = {"op": "kbd", "effect": "solid", "rgb": list(rgb)}
        if int(self.kbd_scale.get_value()) == 0:
            cmd["brightness"] = 100
        self._send(cmd)

    def on_custom_color(self, btn):
        dlg = Gtk.ColorChooserDialog(title="键盘灯颜色", transient_for=self.win)
        if dlg.run() == Gtk.ResponseType.OK:
            c = dlg.get_rgba()
            self.set_color((int(c.red * 200), int(c.green * 200), int(c.blue * 200)))
        dlg.destroy()

    def on_switch(self, sw, pspec, key):
        if self._suppress:
            return
        if key == "ac_led_off":
            self._send({"op": "ac_led_off", "value": sw.get_active()})
        else:
            self._send({"op": "toggle", "name": key, "value": sw.get_active()})


def main():
    app = MrvApp()
    app.win.show_all()
    if app.cfg.get("bubble"):
        app.set_bubble(True)
    Gtk.main()


if __name__ == "__main__":
    main()
