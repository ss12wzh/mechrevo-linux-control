class Bubble(Gtk.Window):
    def __init__(self, app):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.app = app
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_accept_focus(False)
        self.set_resizable(False)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        rgba = enable_rgba(self)

        ev = Gtk.EventBox()
        ev.set_visible_window(False)
        ev.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        ev.connect("button-press-event", self._press)
        box = Gtk.Box(spacing=10)
        add_class(box, "bubble", *(() if rgba else ("opaque",)))
        margin = 8 if rgba else 0
        for side in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{side}")(margin)
        self.vals = {}
        for i, (key, name) in enumerate((("cpu", "CPU"), ("gpu", "GPU"), ("power", "GPU W"))):
            if i:
                box.pack_start(add_class(Gtk.Box(), "bubble-sep"), False, False, 0)
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            v = label("—", "bubble-val")
            col.pack_start(v, False, False, 0)
            col.pack_start(label(name, "bubble-key"), False, False, 0)
            box.pack_start(col, False, False, 0)
            self.vals[key] = v
        ev.add(box)
        self.add(ev)

        self.menu = Gtk.Menu()
        for text, cb in (("打开主窗口", lambda *_: self.app.show_main()),
                         ("关闭悬浮窗", lambda *_: self.app.set_bubble(False))):
            item = Gtk.MenuItem(label=text)
            item.connect("activate", cb)
            self.menu.append(item)
        self.menu.show_all()

    def _press(self, w, e):
        if e.button == 1 and e.type == Gdk.EventType._2BUTTON_PRESS:
            self.app.toggle_main()
        elif e.button == 1:
            self.begin_move_drag(e.button, int(e.x_root), int(e.y_root), e.time)
        elif e.button == 3:
            self.menu.popup_at_pointer(e)
        return True

    def update(self, st):
        ct, gt = st.get("cpu_temp"), st.get("gpu_temp")
        g = st.get("gpu", {})
        self.vals["cpu"].set_text(f"{ct:.0f}°" if ct is not None else "—")
        self.vals["gpu"].set_text(f"{gt:.0f}°" if gt is not None else "—")
        draw = g.get("draw_w")
        self.vals["power"].set_text(f"{draw:.0f}" if draw is not None else ("休眠" if g.get("suspended") else "—"))


