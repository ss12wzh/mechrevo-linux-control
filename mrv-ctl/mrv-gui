# ============================================================ 守护进程通信
def call(cmd, timeout=10.0):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(SOCK_PATH)
        s.sendall(json.dumps(cmd).encode())
        buf = b""
        while chunk := s.recv(65536):
            buf += chunk
        s.close()
        return json.loads(buf.decode())
    except Exception as e:
        return {"ok": False, "error": str(e)}


def load_config():
    try:
        with open(CONFIG_PATH) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_config(cfg):
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w") as f:
            json.dump(cfg, f, indent=2)
    except OSError:
        pass


# ============================================================ 小部件
def label(text="", cls=None, xalign=0.0, **kw):
    w = Gtk.Label(label=text, xalign=xalign, **kw)
    for c in (cls or "").split():
        w.get_style_context().add_class(c)
    return w


def add_class(w, *classes):
    ctx = w.get_style_context()
    for c in classes:
        ctx.add_class(c)
    return w


def icon(name, size=12, cls="section-icon"):
    img = Gtk.Image.new_from_icon_name(name, Gtk.IconSize.MENU)
    img.set_pixel_size(size)
    return add_class(img, cls) if cls else img


def enable_rgba(win):
    """透明窗口 + 面板自绘圆角; 没有合成器时返回 False, 调用方退化为不透明直角"""
    screen = win.get_screen()
    visual = screen.get_rgba_visual()
    if visual and screen.is_composited():
        win.set_visual(visual)
        win.set_app_paintable(True)
        return True
    return False


class Tween:
    """数值滚动到新值 (对应 token-monitor 总数的计数动画)"""

    def __init__(self, lbl, fmt):
        self.lbl, self.fmt = lbl, fmt
        self.cur = None
        self._src = self._dst = 0.0
        self._t0 = 0.0
        self._id = None

    def set(self, v):
        if v is None:
            if self._id:
                GLib.source_remove(self._id)
                self._id = None
            self.cur = None
            self.lbl.set_text("—")
            return
        if self.cur is None:
            self.cur = v
            self.lbl.set_text(self.fmt(v))
            return
        self._src, self._dst, self._t0 = self.cur, v, time.monotonic()
        if not self._id:
            self._id = GLib.timeout_add(16, self._tick)

    def _tick(self):
        p = min(1.0, (time.monotonic() - self._t0) / 0.42)
        self.cur = self._src + (self._dst - self._src) * (1 - (1 - p) ** 3)
        self.lbl.set_text(self.fmt(self.cur))
        if p >= 1.0:
            self._id = None
            return False
        return True


class Metric(Gtk.Box):
    """一个指标: 标签 / 数值 + 细进度条 + 说明 (对应 token-monitor 的 limit-window)"""

    LEVELS = ("accent", "warn", "crit")

    def __init__(self, name, with_bar=True):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        line = Gtk.Box(spacing=8)
        line.pack_start(label(name, "metric-label"), True, True, 0)
        self.value = label("—", "metric-value", xalign=1.0)
        line.pack_end(self.value, False, False, 0)
        self.pack_start(line, False, False, 0)
        self.bar = None
        if with_bar:
            self.bar = Gtk.ProgressBar()
            self.pack_start(self.bar, False, False, 0)
        self.sub = label("", "metric-sub")
        self.sub.set_no_show_all(True)
        self.pack_start(self.sub, False, False, 0)

    def update(self, text, frac=None, level=None, sub=None):
        self.value.set_text(text)
        if self.bar is not None:
            self.bar.set_fraction(max(0.0, min(1.0, frac or 0.0)))
            ctx = self.bar.get_style_context()
            for lv in self.LEVELS:
                ctx.remove_class(lv)
            if level:
                ctx.add_class(level)
        if sub:
            self.sub.set_text(sub)
            self.sub.show()
        else:
            self.sub.hide()


class Section(Gtk.Box):
    """分区: 图标 + 名称 / 右侧型号 / 元信息 / 内容, 底部 1px 细线"""

    def __init__(self, icon_name, name, last=False):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        add_class(self, "section", *(("last",) if last else ()))
        head = Gtk.Box(spacing=8)
        title = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        name_line = Gtk.Box(spacing=8)
        name_line.pack_start(icon(icon_name), False, False, 0)
        name_line.pack_start(label(name, "section-name"), False, False, 0)
        title.pack_start(name_line, False, False, 0)
        self.meta = label("", "section-meta", ellipsize=Pango.EllipsizeMode.END)
        self.meta.set_no_show_all(True)
        self.meta.connect("notify::label", lambda w, _p: w.set_visible(bool(w.get_text())))
        title.pack_start(self.meta, False, False, 0)
        head.pack_start(title, True, True, 0)
        self.plan = label("", "section-plan", xalign=1.0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=22)
        self.plan.set_valign(Gtk.Align.START)
        head.pack_end(self.plan, False, False, 0)
        self.pack_start(head, False, False, 0)

    def grid(self, metrics, columns=2):
        g = Gtk.Grid(column_homogeneous=True, column_spacing=12, row_spacing=10)
        for i, m in enumerate(metrics):
            g.attach(m, i % columns, i // columns, 1, 1)
        self.pack_start(g, False, False, 0)
        return g


class Segmented(Gtk.Box):
    """胶囊分段控件, 单选; on_pick(key) 返回 False 表示拒绝切换"""

    def __init__(self, items, on_pick, wide=False):
        super().__init__(spacing=2, homogeneous=True)
        add_class(self, "tabs", *(("wide",) if wide else ()))
        self.buttons = {}
        self._on_pick = on_pick
        self._busy = False
        for key, text in items:
            b = Gtk.ToggleButton(label=text)
            add_class(b, "tab")
            b.connect("toggled", self._toggled, key)
            self.buttons[key] = b
            self.pack_start(b, True, True, 0)

    def select(self, key):
        self._busy = True
        for k, b in self.buttons.items():
            b.set_active(k == key)
        self._busy = False

    def current(self):
        return next((k for k, b in self.buttons.items() if b.get_active()), None)

    def _toggled(self, btn, key):
        if self._busy:
            return
        if not btn.get_active():
            # 单选: 不允许点掉当前项
            if self.current() is None:
                self._busy = True
                btn.set_active(True)
                self._busy = False
            return
        prev = [k for k, b in self.buttons.items() if b.get_active() and k != key]
        self.select(key)
        if self._on_pick(key) is False:
            self.select(prev[0] if prev else None)


