def call(cmd, timeout=8.0):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(SOCK_PATH)
        s.sendall(json.dumps(cmd).encode())
        resp = json.loads(s.recv(131072).decode())
        s.close()
        return resp
    except Exception as e:
        return {"ok": False, "error": str(e)}


# ============================================================ 悬浮窗
class FloatWin(Gtk.Window):
    def __init__(self):
        super().__init__()
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_accept_focus(False)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_MOTION_MASK)
        self.connect("button-press-event", self._press)
        self.connect("motion-notify-event", self._drag)
        self._drag = None
        outer = Gtk.Box()
        outer.get_style_context().add_class("floatwin")
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        inner.set_margin_top(10); inner.set_margin_bottom(10)
        inner.set_margin_start(14); inner.set_margin_end(14)
        self.lbl = Gtk.Label(xalign=0)
        self.lbl.get_style_context().add_class("float-val")
        inner.pack_start(self.lbl, False, False, 0)
        outer.add(inner)
        self.add(outer)

    def _press(self, w, e):
        self._drag = (e.x_root, e.y_root, self.get_position())

    def _drag(self, w, e):
        if self._drag:
            x0, y0, (wx, wy) = self._drag
            self.move(int(wx + e.x_root - x0), int(wy + e.y_root - y0))

    def update(self, st):
        cpu, gpu = st.get("cpu_temp"), st.get("gpu_temp")
        g = st.get("gpu", {})
        f1 = st.get("fan1_rpm")
        t = f"CPU {cpu:.0f}°  GPU {gpu:.0f}°" if cpu is not None and gpu is not None else ""
        p = f"GPU {g['draw_w']:.0f}W / {g.get('current_limit_w', 0):.0f}W" if g.get("draw_w") is not None else ""
        f = f"风扇 {f1} RPM" if f1 else ""
        self.lbl.set_text("\n".join(x for x in (t, p, f) if x))


