        self._refreshing = False
        self._fan_peak = 6000
        self._pending_mux = None
        self._dragging = set()          # 正在拖动的滑条, 刷新时不回写

        css = Gtk.CssProvider()
        css.load_from_data(CSS.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.win = Gtk.Window(title="mrv-ctl")
        self.win.set_decorated(False)
        self.win.set_resizable(False)
        self.win.set_icon_name("mrv-ctl")
        rgba = enable_rgba(self.win)
        margin = SHADOW_MARGIN if rgba else 0
        self.win.connect("delete-event", self.on_delete)
        self.win.connect("destroy", self.on_quit)

        shell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        shell.set_size_request(380, -1)
        add_class(shell, "shell", *(() if rgba else ("opaque",)))
        for side in ("top", "bottom", "start", "end"):
            getattr(shell, f"set_margin_{side}")(margin)
        self.win.add(shell)

        shell.pack_start(self._build_titlebar(), False, False, 0)
        self.status_lbl = label("", "status-error")
        self.status_lbl.set_no_show_all(True)
        shell.pack_start(self.status_lbl, False, False, 0)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=160)
        self.stack.add_named(self._scroll(self._build_overview()), "overview")
        self.stack.add_named(self._scroll(self._build_controls()), "controls")
        shell.pack_start(self.stack, True, True, 0)
        shell.pack_start(self._build_footer(), False, False, 0)

        self.bubble = Bubble(self)
        self.tray = self._build_tray()

        if "pos" in self.cfg:
            self.win.move(*self.cfg["pos"])
        else:
            self.win.set_position(Gtk.WindowPosition.CENTER)
        self.set_view(self.cfg.get("view", "overview"))
        self.win.set_keep_above(self.cfg.get("keep_above", False))

        GLib.timeout_add(2000, self.refresh)
        self.refresh()
        threading.Thread(target=self._query_mux, daemon=True).start()

