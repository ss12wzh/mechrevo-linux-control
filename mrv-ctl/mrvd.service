[Unit]
Description=MechRevo Linux Console Daemon (mrvd)
After=multi-user.target
ConditionPathExists=/proc/acpi/call

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/mrv/mrvd.py
Restart=always
RestartSec=5
# 兜底: 进程退出时恢复风扇 auto (双保险, 代码内也有信号处理)
ExecStopPost=/bin/sh -c 'cat /sys/class/hwmon/hwmon*/pwm1 2>/dev/null >/dev/null; true'

[Install]
WantedBy=multi-user.target
